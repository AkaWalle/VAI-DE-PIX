{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run:*)",
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(make:*)",
      "Bash(pytest:*)",
      "Bash(python:*)",
      "Bash(alembic:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Read",
      "Write",
      "Edit",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)"
    ]
  },
  "preferredModels": {
    "default": "claude-sonnet-4-20250514",
    "planning": "claude-sonnet-4-20250514",
    "implementation": "claude-sonnet-4-20250514"
  },
  "mcp": {
    "allowedServers": [
      "plugin-neon-postgres-neon",
      "user-github",
      "user-context7",
      "user-playwright",
      "plugin-snyk-secure-development-Snyk"
    ],
    "note": "Ajuste allowedServers conforme MCPs habilitados no time. Segredos ficam em settings.local.json / env."
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__|MCP",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/on-mcp-call.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "outputStyle": ".claude/output-styles/writing.md"
}
